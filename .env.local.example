# EmailJS credentials for the contact form.
# Copy this file to `.env.local` and fill in the real values.
# These are read on the server only (src/app/api/contact/route.ts) and are
# never sent to the browser. `.env.local` is git-ignored.

# Account > Public Keys in the EmailJS dashboard.
EMAILJS_PUBLIC_KEY=your_public_key_here

# Email Services > your service > Service ID.
EMAILJS_SERVICE_ID=service_xxxxxxxxx

# Email Templates > your template > Template ID.
EMAILJS_TEMPLATE_ID=template_xxxxxxxx
